{
  "name": "nuxt-cmpkit",
  "version": "0.1.0",
  "description": "Install the CMPKit consent widget in a Nuxt app: one public key, SSR-safe script tag, and a cookie settings link component.",
  "license": "MIT",
  "type": "module",
  "keywords": ["nuxt", "nuxt-module", "cmpkit", "consent", "cookie-banner", "gdpr", "cmp", "privacy"],
  "repository": { "type": "git", "url": "git+https://github.com/kendrick-k/nuxt-cmpkit.git" },
  "exports": { ".": { "types": "./dist/types.d.mts", "import": "./dist/module.mjs" } },
  "main": "./dist/module.mjs",
  "typesVersions": { "*": { ".": ["./dist/types.d.mts"] } },
  "files": ["dist"],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": { "@nuxt/kit": "^4.0.0" },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.0",
    "nuxt": "^4.1.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": { "nuxt": "^3.15.0 || ^4.0.0" }
}
